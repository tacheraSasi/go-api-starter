# Server
SERVER_PORT=8080
GIN_MODE=debug
TIMEZONE=UTC

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24

# CORS (comma-separated list or *)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_FILE_PATH=logs/app.log

# Database (sqlite | postgres | mysql)
DB_TYPE=sqlite
DB_PATH=core.db

# Option 1: full DSN (takes precedence over the fields below)
# DATABASE_URL=postgres://postgres:password@localhost:5432/go_api_starter?sslmode=disable

# Option 2: individual Postgres/MySQL fields
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=dbname
DB_SSL_MODE=disable

# Redis (asynq broker for core/minion/overseer)
REDIS_URL=redis://localhost:6379

# Asynqmon dashboard at http://localhost:8080/monitoring
MONITORING_USER=admin
MONITORING_PASSWORD=changeme

# syntax=docker/dockerfile:1

################################################################################
# overseer: asynq cron scheduler, enqueues recurring tasks for minions
# Run exactly one replica per environment.
################################################################################

ARG GO_VERSION=1.25.0
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS build

WORKDIR /src

COPY go.mod go.sum ./

RUN --mount=type=cache,target=/go/pkg/mod/ \
    for i in $(seq 1 5); do \
      go mod download && { echo "[go] modules downloaded via proxy"; exit 0; }; \
      echo "[go] download attempt $i/5 failed, retrying in 5s..."; \
      sleep 5; \
    done; \
    for i in $(seq 1 3); do \
      GOPROXY=direct go mod download && { echo "[go] modules downloaded via direct"; exit 0; }; \
      echo "[go] direct attempt $i/3 failed, retrying in 5s..."; \
      sleep 5; \
    done; \
    echo "[go] go mod download failed after all retries"; \
    exit 1

ARG TARGETARCH

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod/ \
    CGO_ENABLED=0 GOARCH=$TARGETARCH \
    go build -ldflags="-w -s" -o /bin/overseer ./cmd/overseer

################################################################################
# Runtime
################################################################################
FROM alpine:3.21 AS final

RUN apk --no-cache add \
    ca-certificates \
    tzdata \
    && update-ca-certificates

ARG UID=10001
RUN adduser \
    --disabled-password \
    --gecos "" \
    --home "/nonexistent" \
    --shell "/sbin/nologin" \
    --no-create-home \
    --uid "${UID}" \
    appuser

USER appuser

COPY --from=build /bin/overseer /bin/overseer

ENTRYPOINT ["/bin/overseer"]
